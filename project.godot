; Nuts! - portrait five-lane acorn catcher
config_version=5

[application]
config/name="Nuts!"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7")
config/icon="res://assets/art/game_icon.png"

[application/boot_splash]
show_image=true
image="res://assets/art/nuts_boot_splash.png"
stretch_mode=1
use_filter=true
bg_color=Color(0.13, 0.22, 0.16, 1)
minimum_display_time=1300

[display/window]
size/viewport_width=1080
size/viewport_height=1920
size/window_width_override=540
size/window_height_override=960
stretch/mode="canvas_items"
handheld/orientation=1

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

[rendering/textures]
vram_compression/import_etc2_astc=true

[input]
move_left={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":4194311)]}
move_right={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":4194313)]}
pause={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":4194305)]}
